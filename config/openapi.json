{
  "openapi": "3.0.3",
  "info": {
    "title": "LLM Service API",
    "version": "2.0.0",
    "description": "Суммаризация текста через GigaChat. Раскройте endpoint и нажмите Try it out, затем Execute. Модель, scope и ключ авторизации задаются на сервере в .env. Ключ и access token в Swagger вводить не нужно."
  },
  "servers": [
    {
      "url": "/",
      "description": "Текущий сервер"
    }
  ],
  "tags": [
    {
      "name": "LLM",
      "description": "Суммаризация текста"
    },
    {
      "name": "Service",
      "description": "Состояние сервиса"
    }
  ],
  "paths": {
    "/chat": {
      "post": {
        "tags": [
          "LLM"
        ],
        "operationId": "summarizeText",
        "summary": "Суммаризировать текст",
        "description": "Резюме на русском в 1–3 предложениях. Точный повтор в течение TTL возвращается из кеша. У сервера есть максимум 3 попытки обращения к провайдеру с таймаутом.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              },
              "examples": {
                "valid": {
                  "summary": "Корректный запрос",
                  "value": {
                    "message": "Команда разработала сервис. Он суммаризирует тексты и кеширует результаты."
                  }
                },
                "missing_message": {
                  "summary": "Ошибка: нет обязательного поля",
                  "value": {}
                },
                "empty_message": {
                  "summary": "Ошибка: пустой текст",
                  "value": {
                    "message": ""
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Резюме или результат из кеша.",
            "headers": {
              "X-Request-ID": {
                "description": "Идентификатор запроса для поиска в логах.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                },
                "example": {
                  "answer": "Команда создала сервис суммаризации с кешированием.",
                  "cached": false,
                  "scenario": "summarize",
                  "model": "GigaChat-2",
                  "request_id": "example-request-id"
                }
              }
            }
          },
          "400": {
            "description": "Неверный ввод или JSON.",
            "headers": {
              "X-Request-ID": {
                "description": "Идентификатор запроса для поиска в логах.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "validation_error",
                    "message": "Поле message обязательно и должно быть непустой строкой."
                  },
                  "request_id": "example-request-id"
                }
              }
            }
          },
          "413": {
            "description": "Тело запроса превышает 16 КБ.",
            "headers": {
              "X-Request-ID": {
                "description": "Идентификатор запроса для поиска в логах.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "http_error",
                    "message": "Размер тела запроса превышает 16 КБ."
                  },
                  "request_id": "example-request-id"
                }
              }
            }
          },
          "502": {
            "description": "Некорректный ответ модели.",
            "headers": {
              "X-Request-ID": {
                "description": "Идентификатор запроса для поиска в логах.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "invalid_llm_response",
                    "message": "Модель вернула некорректный ответ. Попробуйте позже."
                  },
                  "request_id": "example-request-id",
                  "answer": "Модель вернула некорректный ответ. Попробуйте позже.",
                  "cached": false
                }
              }
            }
          },
          "503": {
            "description": "Модель недоступна или ключ не настроен.",
            "headers": {
              "X-Request-ID": {
                "description": "Идентификатор запроса для поиска в логах.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "llm_unavailable",
                    "message": "Сервис временно недоступен, попробуйте позже."
                  },
                  "request_id": "example-request-id",
                  "answer": "Сервис временно недоступен, попробуйте позже.",
                  "cached": false
                }
              }
            }
          },
          "500": {
            "description": "Внутренняя ошибка.",
            "headers": {
              "X-Request-ID": {
                "description": "Идентификатор запроса для поиска в логах.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "Внутренняя ошибка сервиса."
                  },
                  "request_id": "example-request-id"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Service"
        ],
        "operationId": "getHealth",
        "summary": "Проверить работу сервера",
        "description": "Проверяет сам сервис, без обращения к GigaChat.",
        "responses": {
          "200": {
            "description": "Сервер работает.",
            "headers": {
              "X-Request-ID": {
                "description": "Идентификатор запроса для поиска в логах.",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  }
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S",
            "description": "Текст для суммаризации: 1–1000 символов, содержит хотя бы один непробельный символ."
          }
        }
      },
      "ChatResponse": {
        "type": "object",
        "required": [
          "answer",
          "cached",
          "scenario",
          "model",
          "request_id"
        ],
        "properties": {
          "answer": {
            "type": "string",
            "minLength": 1
          },
          "cached": {
            "type": "boolean",
            "description": "true — ответ получен из кеша."
          },
          "scenario": {
            "type": "string",
            "enum": [
              "summarize"
            ]
          },
          "model": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          },
          "request_id": {
            "type": "string"
          },
          "answer": {
            "type": "string",
            "description": "Понятное сообщение при сбое модели."
          },
          "cached": {
            "type": "boolean",
            "description": "При ошибке модели — false."
          }
        }
      }
    }
  }
}
